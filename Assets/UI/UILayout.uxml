<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score: 0" name="ScoreLabel" style="position: absolute; top: 20px; left: 0; right: 0; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 20px; color: rgb(255, 250, 250);"/>
    <ui:VisualElement name="GameOverPanel" style="display: none; position: absolute; top: 0; right: 0; bottom: 0; left: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.72);">
        <ui:Label text="Flight Over" style="margin-bottom: 14px; -unity-font-style: bold; font-size: 36px; color: rgb(255, 255, 255);"/>
        <ui:Label text="Score: 0" name="FinalScoreLabel" style="font-size: 24px; color: rgb(255, 255, 255);"/>
        <ui:Label text="Best: 0" name="BestScoreLabel" style="margin-top: 4px; font-size: 20px; color: rgb(210, 218, 230);"/>
        <ui:Label text="New Best!" name="NewBestLabel" style="margin-top: 8px; margin-bottom: 12px; -unity-font-style: bold; font-size: 22px; color: rgb(255, 210, 65);"/>
        <ui:Button text="Restart" name="RestartButton" style="width: 180px; height: 48px; margin-top: 8px; font-size: 20px; -unity-font-style: bold;"/>
        <ui:Label text="or tap anywhere" style="margin-top: 10px; font-size: 14px; color: rgb(190, 198, 210);"/>
    </ui:VisualElement>
</ui:UXML>
