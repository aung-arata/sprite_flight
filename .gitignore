# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Build outputs and packages you don't want tracked
*.apk
*.aab
*.app
*.unitypackage

# Unity cache and metadata
sysinfo.txt
crashlytics-build.properties
*.dmp
~UnityDirMonSyncFile~*

# Addressables-generated content
Assets/AddressableAssetsData/*/*.bin*
Assets/StreamingAssets/aa.meta
Assets/StreamingAssets/aa/*

# Project-local private files
*.private
*.private.meta
*.private.[0-9]*
*.private.[0-9]*.meta

